{
  "name": "niulai-yellow-desktop-pet",
  "version": "1.0.1",
  "private": true,
  "description": "Codex pet 'niulai-yellow' wrapped as a floating WorkBuddy desktop pet (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "qa:market": "node scripts/run-market-qa.js",
    "qa:watch-alert": "node scripts/run-watch-alert-qa.js",
    "dist:portable": "npx --yes electron-builder@26.15.6 --win portable --x64",
    "dist:setup": "npx --yes electron-builder@26.15.6 --win nsis --x64",
    "dist:all": "npx --yes electron-builder@26.15.6 --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "productName": "牛来看盘神器",
  "author": "Moony",
  "build": {
    "appId": "com.moony.niulai",
    "productName": "牛来看盘神器",
    "electronLanguages": [
      "zh-CN",
      "ja",
      "en-US"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "niulai-ticker.html",
      "spritesheet.webp",
      "tray.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "牛来看盘神器",
      "artifactName": "牛来看盘神器 Setup ${version}.${ext}",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "portable": {
      "artifactName": "牛来看盘神器-${version}-portable.${ext}"
    }
  }
}
